# Server configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1

# MySQL Database configuration (Connection Pool)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ict_support
DB_USER=ict_user
DB_PASSWORD=replace_with_a_strong_secret
DB_CONNECTION_LIMIT=10

# Session & Security
SESSION_SECRET=replace_with_a_random_32_byte_secret_key_minimum_length
SESSION_COOKIE_NAME=ict_session
SESSION_MAX_AGE_MINUTES=480

# File Uploads & Logging
UPLOAD_MAX_MB=10
LOG_LEVEL=info
